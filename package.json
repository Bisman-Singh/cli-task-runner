    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.0",
    "@types/js-yaml": "^4.0.9",
    "ts-node": "^10.9.2"
  }
}
