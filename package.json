{
  "name": "cli-task-runner",
  "version": "1.0.0",
  "description": "Run tasks from a YAML file with dependency resolution and colorful output",
  "main": "dist/index.js",
  "bin": {
    "task-runner": "dist/index.js"
  },
  "scripts": {
